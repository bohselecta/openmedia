{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMediaForge Model Manifest",
  "type": "object",
  "required": [
    "id",
    "providerId",
    "name",
    "task",
    "inputSchema",
    "outputSchema",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "estimatedCost": {
      "type": "object"
    },
    "hardwareRequirements": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
