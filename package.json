{
  "name": "openmediaforge",
  "version": "0.5.2-alpha",
  "private": true,
  "license": "MIT",
  "description": "Local-first, provider-neutral AI media command desk",
  "author": "OpenMediaForge",
  "main": "electron/bootstrap.cjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env OMF_STANDALONE=1 next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "python3 scripts/verify_build.py && npx tsx scripts/verify_runtime.ts",
    "desktop:dev": "cross-env OMF_DEV_PORT=3010 ELECTRON_DISABLE_SANDBOX=1 concurrently -k \"next dev -p 3010\" \"wait-on tcp:3010 && electron electron/bootstrap.cjs --no-sandbox --disable-setuid-sandbox\"",
    "desktop": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron electron/bootstrap.cjs --no-sandbox --disable-setuid-sandbox",
    "desktop:pack": "npm run build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.openmediaforge.app",
    "productName": "OpenMediaForge",
    "copyright": "Copyright © OpenMediaForge",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!src{,/**}",
      "!.next{,/**}",
      "!docs{,/**}",
      "!contracts{,/**}",
      "!scripts{,/**}",
      "!dist-electron{,/**}",
      "!.cursor{,/**}",
      "!.git{,/**}",
      "!**/*.tsbuildinfo",
      "!eslint.config.*",
      "!postcss.config.*",
      "!tailwind.config.*",
      "!tsconfig.json",
      "!next-env.d.ts",
      "!next.config.ts",
      "!BUILD_DIRECTIVE.txt",
      "!STATUS.md",
      "!AGENTS.md"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/dist/sql-wasm.wasm",
      "**/node_modules/keytar/**/*.node"
    ],
    "afterPack": "scripts/after-pack-omf-next.mjs",
    "afterAllArtifactBuild": "scripts/after-all-artifacts-launcher.mjs",
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "maintainer": "OpenMediaForge",
      "executableName": "openmediaforge"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.12",
    "archiver": "^8.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "keytar": "^7.9.0",
    "localforage": "1.10.0",
    "lucide-react": "0.469.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.14.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "wait-on": "^9.0.5"
  }
}
